# Variable inventory only. The app does not load this file.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
